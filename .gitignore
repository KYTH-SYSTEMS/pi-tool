# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing secrets — NEVER commit these (defense in depth; see android/.gitignore)
key.properties
*.jks
*.keystore

# Play service account key (publishing credential — lives in the GitHub secret
# PLAY_SERVICE_ACCOUNT_JSON, never in the repo)
play-service-account*.json
fastlane/*.json

# fastlane run artifacts
fastlane/report.xml
fastlane/README.md

# Generated store screenshots (intermediate; final copies live in fastlane)
test/shots/

# Generated l10n (gen-l10n runs on `flutter pub get` via generate: true)
lib/l10n/app_localizations*.dart
